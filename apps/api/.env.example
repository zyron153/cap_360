# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://maissaude:maissaude@127.0.0.1:5434/maissaude_dev?sslmode=disable"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="cap-files"
R2_PUBLIC_URL="https://files.cap.cv"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=development
WEB_URL="http://localhost:3000"

# SessionAuthGuard normally bypasses auth entirely when NODE_ENV !== "production" for local
# convenience. Requires explicit "true" — an unset/missing value means real session verification runs.
AUTH_BYPASS=true

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32 bytes (64 hex chars), used for AES-256-GCM field encryption (e.g. Patient.nif).
# Generate one per environment: openssl rand -hex 32 — this placeholder is not valid hex.
FIELD_ENCRYPTION_KEY="32-byte-hex-key-change-in-production"

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=""
