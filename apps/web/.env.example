# ─── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4001"

# ─── Keycloak (public values — safe to expose in browser) ────────────────────
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM="cap"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="web"

# ─── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_WHATSAPP=false

# ─── Auth (server-side only — never NEXT_PUBLIC_, must not reach the browser) ─
# middleware.ts normally bypasses the login gate entirely when NODE_ENV !== "production" for
# local convenience. Requires explicit "true" — an unset/missing value means the gate stays on.
AUTH_BYPASS=true
