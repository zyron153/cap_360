# Copy to `.env.prod` ON THE SERVER (never commit the real one — .gitignore covers .env.*).
# One per environment: /opt/cap360-staging/.env.prod and /opt/cap360-prod/.env.prod, each with its
# OWN secrets (generate fresh ones for staging — never reuse prod's).
# Normally driven by scripts/vps/deploy.sh (see Docs/DEPLOYMENT.md), which runs:
#   docker compose -p cap360-<staging|prod> --env-file .env.prod -f docker-compose.prod.yml ...

# ─── Images ──────────────────────────────────────────────────────────────────────
GHCR_OWNER=your-github-user-or-org
# IMAGE_TAG is NOT set here: scripts/vps/deploy.sh exports it per deploy (staging-<sha> /
# prod-<sha>) and records the running one in ./.deployed-tag. For manual compose commands:
#   IMAGE_TAG=$(cat .deployed-tag) docker compose -p ... ps

# ─── Host ports for nginx — staging shares the VPS with prod ─────────────────────
# prod: leave unset (80 / 443).  staging: set both.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ─── Public address — until the domain exists use the VPS IP over http ───────────
# Must match what the browser uses, including the port. No trailing slash, no localhost.
# staging example: http://YOUR_VPS_IP:8080
WEB_URL=http://YOUR_VPS_IP
ALLOWED_ORIGINS=http://YOUR_VPS_IP

# ─── Secrets — generate each one, don't reuse ────────────────────────────────────
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -hex 32   (64 hex chars; LOSING THIS KEY MAKES ENCRYPTED PATIENT DATA UNREADABLE — back it up)
FIELD_ENCRYPTION_KEY=

# ─── First admin (only read by `run --rm seed`; ≥12 chars) ───────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Optional integrations (leave empty to disable) ──────────────────────────────
SENTRY_DSN=
