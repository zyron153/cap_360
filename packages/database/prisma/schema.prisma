// Clinica Mais Saude 360 — Prisma Schema (Phase 1)
// Canonical source: DATABASE-SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Gender {
  male
  female
  other
}

enum StaffRole {
  admin
  doctor
  nurse
  receptionist
  lab_tech
  corporate_hr
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
  no_show
}

enum AppointmentSource {
  web
  whatsapp
  phone
  walk_in
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

enum EFaturaStatus {
  pending
  submitting
  accepted
  rejected
  cancelled
  error
}

enum PaymentMethod {
  cash
  bank_transfer
  health_plan
  vinti4
}

enum ReminderChannel {
  whatsapp
  sms
  email
}

enum DocumentType {
  national_id
  consent_form
  exam_result
  prescription
  referral
  other
}

enum WaitlistStatus {
  waiting
  notified
  booked
  expired
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Patient {
  id                    String    @id @default(uuid())
  /// Nullable so right-to-erasure (softDelete) can null it out; every real patient still has one
  /// (enforced by CreatePatientSchema, not the DB) — null only ever means "erased".
  fullName              String?   @db.VarChar(150)
  /// AES-256-GCM encrypted at application layer (EncryptionService) — "ivHex:authTagHex:dataHex".
  /// Was DateTime @db.Date; stored as ciphertext of "YYYY-MM-DD" now, so it's a plain string.
  /// No lookup hash needed — nothing searches or range-filters by date of birth today.
  /// Nullable so right-to-erasure (softDelete) can null it out — see fullName above.
  dateOfBirth           String?   @db.VarChar(255)
  gender                Gender
  /// AES-256-GCM encrypted at application layer (EncryptionService) — "ivHex:authTagHex:dataHex"
  nif                   String?   @db.VarChar(255)
  /// HMAC-SHA256 blind index of the plaintext NIF — encrypted `nif` above can't be looked up
  /// or uniqueness-checked directly, since AES-GCM ciphertext differs per call (random IV)
  nifHash               String?   @db.VarChar(64)
  /// Nullable so right-to-erasure (softDelete) can null it out — see fullName above. The unique
  /// constraint below still holds: Postgres allows unlimited NULLs in a unique column, so an
  /// erased patient's old number is freed up for a future patient to use.
  phone                 String?   @db.VarChar(30)
  email                 String?   @db.VarChar(150)
  address               String?   @db.VarChar(300)
  emergencyContactName  String?   @db.VarChar(150)
  emergencyContactPhone String?   @db.VarChar(30)
  consentGiven          Boolean   @default(false)
  consentGivenAt        DateTime?
  healthPlanId          String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]
  documents         PatientDocument[]
  notes             PatientNote[]
  communicationLogs CommunicationLog[]
  invoices          Invoice[]
  waitlistEntries   Waitlist[]
  healthPlan        HealthPlan?        @relation(fields: [healthPlanId], references: [id])
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  referrals         Referral[]

  @@unique([phone])
  @@unique([nifHash])
  @@index([fullName])
  @@index([deletedAt])
  @@map("patients")
}

model Staff {
  id            String    @id @default(uuid())
  /// argon2id hash (see PasswordService) — never selected in a normal find; only the login path
  /// reads it explicitly.
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(150)
  email         String    @unique @db.VarChar(150)
  role          StaffRole
  jobTitle      String?   @db.VarChar(100)
  specialtyCode String?   @db.VarChar(50)
  phone         String?   @db.VarChar(30)
  /// Only meaningful for role = corporate_hr — scopes which Company's health plans they can see
  /// (HealthPlansService derives this server-side; a corporate_hr caller can't override it via a
  /// query param). Null for every other role.
  companyId     String?   @db.VarChar(36)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company           Company?            @relation(fields: [companyId], references: [id])
  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]
  shifts            StaffShift[]
  availability      StaffAvailability[]
  leaveRequests     LeaveRequest[]
  patientNotes      PatientNote[]
  requestedExpenses Expense[]           @relation("ExpenseRequestedBy")
  approvedExpenses  Expense[]           @relation("ExpenseApprovedBy")
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  referralsSent     Referral[]          @relation("ReferralReferredBy")
  referralsReceived Referral[]          @relation("ReferralTarget")

  @@index([role])
  @@index([deletedAt])
  @@index([companyId])
  @@map("staff")
}

model StaffInvitation {
  id            String    @id @default(uuid())
  token         String    @unique @db.VarChar(64)
  email         String    @db.VarChar(150)
  fullName      String    @db.VarChar(150)
  role          StaffRole
  jobTitle      String?   @db.VarChar(100)
  specialtyCode String?   @db.VarChar(50)
  phone         String?   @db.VarChar(30)
  /// Copied onto the real Staff row at activation — see Staff.companyId. Not a real FK here,
  /// same denormalized-until-activation style as the other fields above.
  companyId     String?   @db.VarChar(36)
  availability  Json?
  invitedBy     String?   @db.VarChar(150)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("staff_invitations")
}

model Service {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(150)
  code            String   @unique @db.VarChar(30)
  description     String?  @db.VarChar(500)
  durationMinutes Int      @default(30)
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments  Appointment[]
  appointmentSeries AppointmentSeries[]
  invoiceItems  InvoiceItem[]
  waitlistItems Waitlist[]
  examRequests  ExamRequest[]

  @@map("services")
}

model Room {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  floor       String?  @db.VarChar(20)
  capacity    Int      @default(1)
  equipment   Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  appointmentSeries AppointmentSeries[]

  @@map("rooms")
}

// ─── Appointments ────────────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  patientId          String
  staffId            String
  serviceId          String
  roomId             String?
  scheduledAt        DateTime
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(pending)
  source             AppointmentSource @default(web)
  notes              String?           @db.VarChar(500)
  cancellationReason String?           @db.VarChar(300)
  checkedInAt        DateTime?
  completedAt        DateTime?
  /// Client-supplied dedup key — a retried "create appointment" request (double-click, timeout
  /// retry) with the same key returns the existing appointment instead of creating a duplicate.
  idempotencyKey     String?           @db.VarChar(100)
  /// The recurring series this occurrence belongs to, if it was created as part of one.
  seriesId           String?
  /// 1-based position within the series (e.g. "Sessão 3 de 8") — display only, not used for logic.
  seriesIndex        Int?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient   Patient  @relation(fields: [patientId], references: [id])
  staff     Staff    @relation(fields: [staffId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])
  room      Room?    @relation(fields: [roomId], references: [id])
  series    AppointmentSeries? @relation(fields: [seriesId], references: [id])
  reminders AppointmentReminder[]
  invoices  Invoice[]
  examRequests ExamRequest[]
  clinicalNotes ClinicalNote[]

  @@unique([idempotencyKey])
  @@index([patientId])
  @@index([staffId])
  @@index([scheduledAt])
  @@index([status])
  @@index([deletedAt])
  @@index([seriesId])
  @@index([patientId, deletedAt])   // BFF patient-screen: appointments WHERE patientId AND deletedAt IS NULL
  @@index([scheduledAt, deletedAt]) // calendar query: WHERE scheduledAt BETWEEN x AND y AND deletedAt IS NULL
  @@map("appointments")
}

/// A recurring booking template. Occurrences are pre-generated at creation time as normal
/// Appointment rows (linked via seriesId) — each one goes through the exact same booking checks
/// (business hours, holidays, leave, staff/room conflicts) as a manually-created appointment, so
/// nothing else in the system needs to know a series exists at all.
model AppointmentSeries {
  id              String              @id @default(uuid())
  patientId       String
  staffId         String
  serviceId       String
  roomId          String?
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  /// Exactly one of endDate / occurrenceCount is set — enforced at the application layer, since
  /// Prisma has no XOR constraint.
  endDate         DateTime?           @db.Date
  occurrenceCount Int?
  /// Client-supplied dedup key — a retried "create series" request (double-click, slow-network
  /// retry) with the same key returns the existing series instead of creating a duplicate.
  idempotencyKey  String?             @unique @db.VarChar(100)
  createdAt       DateTime            @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id])
  staff        Staff         @relation(fields: [staffId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  room         Room?         @relation(fields: [roomId], references: [id])
  appointments Appointment[]

  @@map("appointment_series")
}

model AppointmentReminder {
  id             String          @id @default(uuid())
  appointmentId  String
  channel        ReminderChannel
  scheduledFor   DateTime
  bullJobId      String?         @db.VarChar(100)
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([scheduledFor])
  @@map("appointment_reminders")
}

model Waitlist {
  id                String         @id @default(uuid())
  patientId         String
  serviceId         String
  staffId           String?
  preferredDateFrom DateTime?      @db.Date
  preferredDateTo   DateTime?      @db.Date
  notes             String?        @db.VarChar(300)
  status            WaitlistStatus @default(waiting)
  notifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([patientId])
  @@index([serviceId])
  @@index([status])
  @@map("waitlist")
}

// ─── Patient Records ─────────────────────────────────────────────────────────

model PatientDocument {
  id          String       @id @default(uuid())
  patientId   String
  type        DocumentType
  fileName    String       @db.VarChar(200)
  r2Key       String       @db.VarChar(300)
  mimeType    String       @db.VarChar(100)
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime     @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patient_documents")
}

model PatientNote {
  id        String   @id @default(uuid())
  patientId String
  content   String   @db.VarChar(2000)
  createdBy String
  createdAt DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id])
  staffAuthor Staff?  @relation(fields: [createdBy], references: [id])

  @@index([patientId])
  @@map("patient_notes")
}

// ─── Clinical Records (M7) ─────────────────────────────────────────────────────
// "Assigned clinician" access (who may read a note) is derived from authorship, not a separate
// assignment table — see ClinicalRecordsService. A note is editable by its author within 24h of
// creation, or by admin at any time (checked in the service against createdAt — no stored lock
// field needed for that alone).

enum RiskLevel {
  none
  low
  moderate
  high
}

enum ReferralType {
  internal
  external
}

enum ReferralStatus {
  pending
  scheduled
  completed
  declined
}

model ClinicalNote {
  id                 String    @id @default(uuid())
  patientId          String
  /// The session this note documents, when it was written off a specific appointment — optional
  /// since a note can also record an ad-hoc contact with no booked slot.
  appointmentId      String?
  authorStaffId      String
  sessionType        String    @db.VarChar(50)
  durationMinutes    Int?
  /// AES-256-GCM encrypted at the application layer (EncryptionService), like Patient.nif/
  /// dateOfBirth — "ivHex:authTagHex:dataHex". @db.Text (not VarChar) because ciphertext runs
  /// longer than the plaintext it replaces: worst case (every char a 4-byte UTF-8 codepoint) is
  /// roughly 8x the original character count once hex-encoded.
  /// S — client-reported concerns, mood, history since last session.
  presentingConcerns String    @db.Text
  /// O — clinician's observations of affect, behaviour, presentation.
  observations       String    @db.Text
  /// A — clinical impression, progress against treatment goals.
  assessment         String    @db.Text
  /// P — interventions planned, homework, focus for next session.
  plan               String    @db.Text
  riskLevel          RiskLevel @default(none)
  /// Required detail once riskLevel is above "none" — enforced in CreateClinicalNoteSchema, not
  /// the DB (Postgres has no cross-column conditional-required constraint worth the complexity).
  /// Encrypted like the fields above.
  riskNotes          String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  author        Staff          @relation(fields: [authorStaffId], references: [id])
  prescriptions Prescription[]
  referrals     Referral[]

  @@index([patientId])
  @@index([authorStaffId])
  @@map("clinical_notes")
}

model Prescription {
  id                  String   @id @default(uuid())
  patientId           String
  clinicalNoteId      String?
  prescribedByStaffId String
  issuedAt            DateTime @default(now())
  /// AES-256-GCM encrypted, same as ClinicalNote's text fields.
  notes               String?  @db.Text
  createdAt           DateTime @default(now())

  patient      Patient            @relation(fields: [patientId], references: [id])
  clinicalNote ClinicalNote?      @relation(fields: [clinicalNoteId], references: [id])
  prescribedBy Staff              @relation(fields: [prescribedByStaffId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  /// All four below AES-256-GCM encrypted, same as ClinicalNote's text fields — a drug name and
  /// dosage are as clinically sensitive as anything in the note itself.
  drugName       String  @db.Text
  dosage         String  @db.Text
  frequency      String  @db.Text
  durationDays   Int?
  instructions   String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model Referral {
  id                   String         @id @default(uuid())
  patientId            String
  clinicalNoteId       String?
  referredByStaffId    String
  type                 ReferralType
  /// Set only when type = internal (another CAP clinician); null for external referrals.
  targetStaffId        String?
  /// Set only when type = external; null for internal referrals.
  externalProviderName String?        @db.VarChar(150)
  externalSpecialty    String?        @db.VarChar(100)
  reason               String         @db.VarChar(1000)
  status               ReferralStatus @default(pending)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  clinicalNote ClinicalNote? @relation(fields: [clinicalNoteId], references: [id])
  referredBy   Staff         @relation("ReferralReferredBy", fields: [referredByStaffId], references: [id])
  targetStaff  Staff?        @relation("ReferralTarget", fields: [targetStaffId], references: [id])

  @@index([patientId])
  @@map("referrals")
}

model CommunicationLog {
  id         String   @id @default(uuid())
  patientId  String
  channel    String   @db.VarChar(30)
  direction  String   @db.VarChar(10)
  subject    String?  @db.VarChar(200)
  body       String?  @db.Text
  status     String   @db.VarChar(30)
  externalId String?  @db.VarChar(100)
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([channel])
  @@map("communication_log")
}

// ─── Companies ───────────────────────────────────────────────────────────────

model Company {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(150)
  taxId     String    @unique @db.VarChar(50)
  email     String?   @db.VarChar(150)
  phone     String?   @db.VarChar(30)
  address   String?   @db.VarChar(300)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  healthPlans HealthPlan[]
  products    HealthPlanProduct[]
  staff       Staff[]

  @@index([active])
  @@map("companies")
}

// ─── Health Plans ─────────────────────────────────────────────────────────────

model HealthPlanProduct {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(150)
  code            String   @unique @db.VarChar(30)
  description     String?  @db.VarChar(500)
  companyId       String?  @db.VarChar(36)
  monthlyFee      Decimal  @db.Decimal(10, 2)
  maxMembers      Int?
  coverageRules   Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company?    @relation(fields: [companyId], references: [id])
  healthPlans HealthPlan[]

  @@index([companyId])
  @@map("health_plan_products")
}

model HealthPlan {
  id              String    @id @default(uuid())
  productId       String
  holderPatientId String?
  companyId       String?
  planNumber      String    @unique @db.VarChar(50)
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  active          Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product  HealthPlanProduct @relation(fields: [productId], references: [id])
  company  Company?          @relation(fields: [companyId], references: [id])
  patients Patient[]
  invoices Invoice[]

  @@index([holderPatientId])
  @@index([companyId])
  @@map("health_plans")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @db.VarChar(20)
  patientId     String
  appointmentId String?
  /// Which health plan (if any) this invoice was billed against — set at creation time from the
  /// patient's then-active plan; not re-derived later if the patient's plan later changes.
  healthPlanId  String?
  status        InvoiceStatus @default(draft)
  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?       @db.VarChar(500)
  dueDate       DateTime?     @db.Date
  issuedAt      DateTime?
  pdfR2Key      String?       @db.VarChar(300)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient           Patient            @relation(fields: [patientId], references: [id])
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id])
  healthPlan        HealthPlan?        @relation(fields: [healthPlanId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  efaturaSubmission EFaturaSubmission?

  @@index([patientId])
  @@index([status])
  @@index([issuedAt])
  @@index([healthPlanId])
  @@index([status, createdAt]) // BFF billing-summary: WHERE status = 'issued' AND createdAt >= startOfMonth
  @@index([patientId, status]) // patient invoice timeline: WHERE patientId ORDER BY createdAt
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String  @db.VarChar(200)
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?       @db.VarChar(100)
  /// Client-supplied dedup key — a retried "record payment" request (double-click, timeout
  /// retry) with the same key returns the existing payment instead of recording it twice.
  idempotencyKey String?  @db.VarChar(100)
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([invoiceId])
  @@map("payments")
}

// ─── E-Factura ───────────────────────────────────────────────────────────────

model EFaturaSubmission {
  id           String        @id @default(uuid())
  invoiceId    String        @unique
  status       EFaturaStatus @default(pending)
  atcud        String?       @db.VarChar(100)
  efaturaRef   String?       @db.VarChar(100)
  errorCode    String?       @db.VarChar(50)
  errorMessage String?       @db.VarChar(500)
  retryCount   Int           @default(0)
  submittedAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("efatura_submissions")
}

// ─── Financeiro (expenses + manual income; invoice payments are the other side of Entradas) ──

model Expense {
  id            String        @id @default(uuid())
  description   String        @db.VarChar(200)
  category      String        @db.VarChar(100)
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime      @db.Date
  supplier      String?       @db.VarChar(150)
  method        PaymentMethod
  reference     String?       @db.VarChar(100)
  receiptR2Key  String?       @db.VarChar(300)
  status        ExpenseStatus @default(pending)
  notes         String?       @db.VarChar(500)
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requestedBy Staff? @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  approvedBy  Staff? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([date])
  @@map("expenses")
}

model Income {
  id          String   @id @default(uuid())
  description String   @db.VarChar(200)
  category    String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @db.Date
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("income")
}

// ─── Exams (Phase 1 stub, fully used in M5) ──────────────────────────────────

model ExamRequest {
  id            String   @id @default(uuid())
  patientId     String
  appointmentId String?
  serviceId     String
  requestedBy   String
  notes         String?  @db.VarChar(500)
  status        String   @default("pending") @db.VarChar(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service     Service     @relation(fields: [serviceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@map("exam_requests")
}

// ─── Staff Scheduling ────────────────────────────────────────────────────────

model StaffShift {
  id        String   @id @default(uuid())
  staffId   String
  shiftDate DateTime @db.Date
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  notes     String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, shiftDate])
  @@index([shiftDate])
  @@map("staff_shifts")
}

model StaffAvailability {
  id          String  @id @default(uuid())
  staffId     String
  dayOfWeek   Int
  startTime   String  @db.VarChar(5)
  endTime     String  @db.VarChar(5)
  slotMinutes Int     @default(30)
  active      Boolean @default(true)

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, dayOfWeek, startTime])
  @@map("staff_availability")
}

model LeaveRequest {
  id        String   @id @default(uuid())
  staffId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.VarChar(300)
  status    String   @default("pending") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("leave_requests")
}

// ─── Public Holidays ─────────────────────────────────────────────────────────

model PublicHoliday {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  name        String   @db.VarChar(100)
  recurring   Boolean  @default(true)
  countryCode String   @default("CV") @db.VarChar(5)
  createdAt   DateTime @default(now())

  @@unique([date, countryCode])
  @@map("public_holidays")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Parametrizacao {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(100)
  valor     String    @db.VarChar(191)
  codigo    String?   @db.VarChar(100)
  descricao String?   @db.VarChar(255)
  ordem     Int       @default(0)
  ativo     Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([nome, ativo, deletedAt])
  @@map("parametrizacoes")
}

/// Append-only at the DB level via a trigger, not just app convention — see
/// prisma/manual-sql/audit-log-immutable.sql (must be re-run by hand on a fresh database; not
/// something `db push`/`migrate` can express or reapply).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @db.VarChar(36)
  actorEmail String?  @db.VarChar(150)
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(36)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(300)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_log")
}
